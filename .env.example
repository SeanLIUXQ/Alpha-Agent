DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=<DOUBAO_ENDPOINT_ID>
DOUBAO_API_KEY=<DOUBAO_API_KEY>

SERVER_PORT=3002
WEB_PORT=5173
DATABASE_URL=file:../../../data/alpha-agent.sqlite
CONDUIT_SANDBOX_PATH=apps/conduit-sandbox

# Optional: Conduit sandbox PostgreSQL connection. Prefer this over DATABASE_URL
# because DATABASE_URL is reserved for the Alpha Agent SQLite database.
CONDUIT_DATABASE_URL=postgres://<DB_USER>:<DB_PASSWORD>@localhost:5432/conduit_development

GITHUB_TOKEN=<OPTIONAL_GITHUB_TOKEN>
ENABLE_PR_CREATE=false
MAX_REPAIR_ATTEMPTS=3
